# Sourced by trusted host scripts. Use simple values and no shell commands.
FRONTEND_DOMAIN=feedback.jghealthcare.com
# Set equal to FRONTEND_DOMAIN for the same-origin /backend/ deployment.
API_DOMAIN=feedback.jghealthcare.com
# Optional additional hostname redirected to FRONTEND_DOMAIN; leave empty when unused.
WWW_DOMAIN=
CERTBOT_EMAIL=replace-me@example.com
# Explicit opt-in when no certificate notification email is available.
CERTBOT_WITHOUT_EMAIL=false
# Choose free loopback ports after inspecting the target server.
BACKEND_PORT=18000
FRONTEND_PORT=18080
BACKUP_RETENTION_DAYS=14
# Either a verified restic offsite repository or explicit temporary local-only acceptance.
BACKUP_MODE=offsite
# Set true only for a confirmed new database with no previous production data to import.
INITIALIZE_EMPTY_DATABASE=false
# RESTIC_REPOSITORY and credentials live in env/backup.env; not in this file.
