# Main production configuration. Copy securely to /opt/healthcare-feedback/.env (mode 600).
# Values are literal and unquoted. $ and # in passwords are preserved; do not add inline comments.
FRONTEND_DOMAIN=feedback.jghealthcare.com
API_DOMAIN=feedback.jghealthcare.com
WWW_DOMAIN=
BACKEND_PORT=18000
FRONTEND_PORT=18080
DJANGO_SECRET_KEY=replace-me-with-new-generated-secret-at-least-50-characters
DJANGO_TIME_ZONE=Asia/Dhaka
# Empty origin/host overrides are derived from the domains above.
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=
POSTGRES_DB=healthcare_feedback
POSTGRES_USER=healthcare_feedback
POSTGRES_PASSWORD=replace-me-with-new-generated-database-password
POSTGRES_SSLMODE=prefer
# Explicitly disabled for the initial release. Set true only after supplying real SMTP settings.
EMAIL_ALERTS_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
LOW_RATING_EMAILS=
# These values are public browser configuration, loaded at startup without rebuilding the frontend.
PUBLIC_API_URL=/backend/api/
PUBLIC_BULK_SMS_API_URL=https://bulksmsbd.net/api/smsapi
CERTBOT_WITHOUT_EMAIL=true
CERTBOT_EMAIL=
BACKUP_MODE=local-only-accepted
BACKUP_RETENTION_DAYS=14
INITIALIZE_EMPTY_DATABASE=true
# Offsite provider configuration is optional while local-only mode is selected.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/healthcare-feedback/env/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
